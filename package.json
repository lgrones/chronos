{
  "name": "chronos-temporal",
  "version": "0.0.0",
  "private": true,
  "description": "Day.js-style syntax sugar for the Temporal API",
  "keywords": [
    "chainable",
    "date",
    "dayjs",
    "fluent",
    "sugar",
    "syntactic-sugar",
    "temporal",
    "time"
  ],
  "homepage": "https://github.com/lgrones/chronos#readme",
  "bugs": {
    "url": "https://github.com/lgrones/chronos/issues"
  },
  "license": "MIT",
  "author": "Leah Grones",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgrones/chronos.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "bumpp"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
